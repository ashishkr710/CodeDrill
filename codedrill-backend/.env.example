# Server Environment
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Database Connection
MONGODB_URI=mongodb://localhost:27017/codedrill

# Authentication JWT Secrets (min 32 characters)
JWT_ACCESS_SECRET=codedrill_super_secret_access_jwt_key_development_32chars!
JWT_REFRESH_SECRET=codedrill_super_secret_refresh_jwt_key_development_32chars!
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Sandboxed Execution Engine
EXECUTION_SANDBOX_TYPE=mock
JUDGE0_API_URL=http://localhost:2358
JUDGE0_API_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
CODE_EXECUTION_MAX_PER_MINUTE=15
